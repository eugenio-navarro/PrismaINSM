# ----------------------------------------------------------------
# .gitignore para proyectos de Unity
# Estas carpetas/archivos los genera Unity o Visual Studio solos,
# así que NO se suben a GitHub (se recrean al abrir el proyecto).
# ----------------------------------------------------------------

# Carpetas generadas por Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Carpeta de Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/

# Archivos de solución y proyecto que genera Unity automáticamente
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Metadatos de archivos de Unity que no hacen falta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Reportes de crash
sysinfo.txt

# Builds (se publican en "Releases" de GitHub, no en el repo)
*.apk
*.aab
*.unitypackage
*.app

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Carpeta de Plastic SCM / Unity Version Control
.plastic/
ignore.conf
